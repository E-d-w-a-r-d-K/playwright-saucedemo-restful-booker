{
  "name": "allright-qa-test",
  "version": "1.0.0",
  "private": true,
  "description": "UI tests for saucedemo.com and API tests for restful-booker on Playwright + TypeScript",
  "author": "Eduard Krykota",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit -p .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
